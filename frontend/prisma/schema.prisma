// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum AccountType {
  Editor
  Approver
  Sender
}

model User {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  email    String @unique
  username String @unique
  password String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accountType AccountType @default(Editor)

  active Boolean @default(true)

  // Relations
  newsletters    Newsletter[]
  comments       Comment[]
  commentReplies CommentReply[]
  blogPosts      BlogPost[]
  newsletterVersions NewsletterVersion[]
}

enum NewsletterStatus {
  Draft
  Seeking_Approval
  Approved
  Ready_To_Send
  Sent
}

model Newsletter {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  dueDate  DateTime
  sentDate DateTime?

  sent Boolean @default(false)

  status NewsletterStatus @default(Draft)

  isSupportingNews Boolean @default(false)

  editionNumber Int? @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  createdBy   User   @relation(fields: [createdById], references: [id], onDelete: Cascade)
  createdById String @db.ObjectId

  content  NewsletterContent?
  comments Comment[]
  versions NewsletterVersion[]
}

model NewsletterContent {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  title String

  content String

  state Json?

  variables String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  newsletter Newsletter @relation(fields: [newsletterId], references: [id], onDelete: Cascade)

  newsletterId String @unique @db.ObjectId
}

// Comments and replies attached to specific blocks within a newsletter
model Comment {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  newsletter   Newsletter @relation(fields: [newsletterId], references: [id], onDelete: Cascade)
  newsletterId String     @db.ObjectId

  blockId String

  author   User?   @relation(fields: [authorId], references: [id], onDelete: SetNull)
  authorId String? @db.ObjectId

  content  String
  resolved Boolean @default(false)

  replies CommentReply[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CommentReply {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  comment   Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  commentId String  @db.ObjectId

  author   User?   @relation(fields: [authorId], references: [id], onDelete: SetNull)
  authorId String? @db.ObjectId

  // type: "text" | "voice"
  type     String  @default("text")
  text     String?
  voiceUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Recipients {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  email String @unique

  isfromUniversity Boolean? @default(false)

  isSubscribed Boolean? @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model UnsubscribeFeedback {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  email    String
  feedback String

  createdAt DateTime @default(now())
}

model BlogPost {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  title         String
  content       String?  // HTML content
  state         Json?    // Editor state JSON
  editionNumber Int?
  newsletterId  String?  @db.ObjectId

  authorId      String?  @db.ObjectId
  author        User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model NewsletterVersion {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  newsletterId String @db.ObjectId
  newsletter   Newsletter @relation(fields: [newsletterId], references: [id], onDelete: Cascade)

  name        String?
  description String?
  state       Json
  content     String

  createdById String @db.ObjectId
  createdBy   User   @relation(fields: [createdById], references: [id])

  createdAt DateTime @default(now())
}
